{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "path",
    "bytes",
    "contentHash",
    "system",
    "license",
    "source",
    "oracle"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 134217728
    },
    "contentHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "system": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "oracle": {
      "type": "object"
    }
  }
}
